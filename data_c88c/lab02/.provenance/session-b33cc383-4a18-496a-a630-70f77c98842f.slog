{"data":{"content":"\"\"\"Lab 2: Control.\"\"\"\n\n\ndef falling(n, k):\n    \"\"\"Compute the falling factorial of n to depth k.\n\n    >>> falling(6, 3)  # 6 * 5 * 4\n    120\n    >>> falling(4, 3)  # 4 * 3 * 2\n    24\n    >>> falling(4, 1)  # 4\n    4\n    >>> falling(4, 0)\n    1\n    \"\"\"\n    \"*** YOUR CODE HERE ***\"\n\n\ndef divisible_by_k(n, k):\n    \"\"\"Print all positive integers up to n that are divisible by k from smallest\n    to largest, then return how many numbers were printed.\n\n    >>> a = divisible_by_k(10, 2)  # 2, 4, 6, 8, and 10 are divisible by 2\n    2\n    4\n    6\n    8\n    10\n    >>> a\n    5\n    >>> b = divisible_by_k(3, 1)  # 1, 2, and 3 are divisible by 1\n    1\n    2\n    3\n    >>> b\n    3\n    >>> c = divisible_by_k(6, 7)  # There are no integers up to 6 that are divisible by 7\n    >>> c\n    0\n    \"\"\"\n    \"*** YOUR CODE HERE ***\"\n\n\ndef double_eights(n):\n    \"\"\"Return true if n has two eights in a row.\n    >>> double_eights(8)\n    False\n    >>> double_eights(88)\n    True\n    >>> double_eights(2882)\n    True\n    >>> double_eights(880088)\n    True\n    >>> double_eights(12345)\n    False\n    >>> double_eights(80808080)\n    False\n    \"\"\"\n    \"*** YOUR CODE HERE ***\"\n\n\ndef sum_digits(y):\n    \"\"\"Sum all the digits of y.\n\n    >>> sum_digits(10) # 1 + 0 = 1\n    1\n    >>> sum_digits(4224) # 4 + 2 + 2 + 4 = 12\n    12\n    >>> sum_digits(1234567890)\n    45\n    >>> a = sum_digits(123) # make sure that you are using return rather than print\n    >>> a\n    6\n    \"\"\"\n    \"*** YOUR CODE HERE ***\"\n","line_count":76,"path":"lab02.py","sha256":"d0531a339e6b797ee408eb588179ca610e44ad74331a47a0e2a14581dfbaeced"},"hash":"feda3163c4e20e2178dcaef121ac53b61b1c6e047dc888bc278358c6396dba6f","kind":"doc.open","prev_hash":"e23f8312fe78190dc8a19e11ac48b4cb97bcfa06f1f7d6d06dd6c9bfc44c7005","seq":1,"t":3,"wall":"2026-09-09T04:46:50.898Z"}
